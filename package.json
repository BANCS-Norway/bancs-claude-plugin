{
  "name": "@bancs/bancs-claude-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "BANCS Claude Plugin (bcp) — git-worktree handling and a mission system with swappable agent workforces.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint": "markdownlint-cli2 '**/*.md' '#node_modules' '#CHANGELOG.md'",
    "lint:fix": "markdownlint-cli2 --fix '**/*.md' '#node_modules' '#CHANGELOG.md'",
    "test:hooks": "node --test scripts/hooks.test.mjs",
    "test:skills": "node --test scripts/skill-frontmatter.test.mjs",
    "test:stop": "node --test scripts/stop-check.test.mjs",
    "test:nudge": "node --test scripts/nudge.test.mjs",
    "test:version": "node --test scripts/version-check.test.mjs",
    "test:shims": "node --test scripts/shims.test.mjs",
    "test:context": "node --test scripts/project-context.test.mjs",
    "test:preflight": "node --test scripts/worktree-preflight.test.mjs",
    "test:literals": "node --test scripts/skill-literals.test.mjs",
    "test:start": "node --test scripts/worktree-start.test.mjs",
    "test:finish": "node --test scripts/worktree-finish.test.mjs",
    "test:worklog": "node --test scripts/work-log.test.mjs",
    "test:linked": "node --test scripts/linked-issue.test.mjs",
    "test:guard": "node --test scripts/commit-guard.test.mjs",
    "test:issues": "node --test scripts/issues-start.test.mjs",
    "test": "node scripts/validate.mjs && npm run test:hooks && npm run test:skills && npm run test:stop && npm run test:nudge && npm run test:version && npm run test:shims && npm run test:context && npm run test:preflight && npm run test:literals && npm run test:start && npm run test:finish && npm run test:worklog && npm run test:linked && npm run test:guard && npm run test:issues",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BANCS-Norway/bancs-claude-plugin.git"
  },
  "keywords": [
    "claude-code",
    "claude-plugin",
    "bancs"
  ],
  "author": "BANCS Norway",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BANCS-Norway/bancs-claude-plugin/issues"
  },
  "homepage": "https://github.com/BANCS-Norway/bancs-claude-plugin#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli2": "^0.22.0",
    "semantic-release": "^25.0.3"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2"
  }
}
